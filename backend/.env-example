# YouTube RAG Backend Configuration
OPENAI_API_KEY=yout_openai_api_key
# Preferred key name for llama-index GoogleGenAI
GOOGLE_API_KEY=your_google_api_key
YOUTUBE_COOKIES_PATH=./cookies.txt
CHROMA_DB_PATH=./chroma_db
YOUTUBE_SOURCE_BROWSER=chrome

# Webshare rotating residential proxy (optional, but recommended for cloud deployments)
# Sign up at https://www.webshare.io/ and purchase a "Residential Rotating" proxy package
# Get credentials from: https://proxy2.webshare.io/proxy/settings
WEBSHARE_PROXY_USERNAME=webshare_username
WEBSHARE_PROXY_PASSWORD=webshare_password
